# Copy this file to .env and replace every value marked CHANGE_ME.
# Generate a URL-safe password, for example: openssl rand -hex 32

# PostgreSQL container administrator (used for initialization and DataGrip
# administration; never used by the application)
POSTGRES_DB=spendime
POSTGRES_USER=spendime_admin
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ADMIN_HEX_VALUE

# Least-privileged runtime login created after the schema initializes. Use a
# different generated password from the administrator password.
APP_DB_USER=spendime_app
APP_DB_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_RANDOM_APP_HEX_VALUE

# Used by the Node application inside Docker. The hostname MUST remain
# "postgres" because that is the Compose service name. Keep the credentials in
# sync with APP_DB_USER, APP_DB_PASSWORD, and POSTGRES_DB above.
DATABASE_URL=postgresql://spendime_app:CHANGE_ME_USE_A_DIFFERENT_RANDOM_APP_HEX_VALUE@postgres:5432/spendime

# Database port exposure. 127.0.0.1 is safest and only permits connections from
# the Pi itself. To use DataGrip over your LAN, replace this with the Pi's static
# LAN address (for example 192.168.1.50). Do not use 0.0.0.0 here.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Application HTTP exposure. 0.0.0.0 makes the PWA reachable from other devices
# on the LAN. Do not forward this port from your router until HTTPS is configured.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000

NODE_ENV=production
