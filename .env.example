# Copy this file to .env and replace every value marked CHANGE_ME.
# Generate a URL-safe password, for example: openssl rand -hex 32

# PostgreSQL container administrator (used for initialization and DataGrip
# administration; never used by the application)
POSTGRES_DB=spendime
POSTGRES_USER=spendime_admin
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ADMIN_HEX_VALUE

# Least-privileged runtime login created after the schema initializes. Use a
# different generated password from the administrator password.
APP_DB_USER=spendime_app
APP_DB_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_RANDOM_APP_HEX_VALUE

# Used by the Node application inside Docker. The hostname MUST remain
# "postgres" because that is the Compose service name. Keep the credentials in
# sync with APP_DB_USER, APP_DB_PASSWORD, and POSTGRES_DB above.
DATABASE_URL=postgresql://spendime_app:CHANGE_ME_USE_A_DIFFERENT_RANDOM_APP_HEX_VALUE@postgres:5432/spendime

# Database port exposure. 127.0.0.1 is safest and only permits connections from
# the Pi itself. To use DataGrip over your LAN, replace this with the Pi's static
# LAN address (for example 192.168.1.50). Do not use 0.0.0.0 here.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432

# Application HTTP exposure. 0.0.0.0 makes the PWA reachable from other devices
# on the LAN. Do not forward this port from your router until HTTPS is configured.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000

NODE_ENV=production

# Authentication and database connection pool
DB_POOL_MAX=10
SESSION_TTL_HOURS=720

# auto: add Secure when the request is HTTPS. Use always once HTTPS is
# terminated by a trusted reverse proxy; use never only for local HTTP testing.
COOKIE_SECURE=auto

# Set to 1 only when directly behind a trusted reverse proxy. This lets Express
# honor X-Forwarded-Proto and set Secure cookies for HTTPS.
TRUST_PROXY=0

# Optional fixed browser origin, such as https://finance.example.net. Leave
# blank for same-host LAN/PWA use so the request Host header is used.
APP_ORIGIN=

# Basic per-process protection for register/login endpoints.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Optional dedicated integration-test database URL. When blank, tests use
# DATABASE_URL and remove only their uniquely named users afterward.
TEST_DATABASE_URL=

# Local SANDBOX application only. Never use these credentials in production.
# Use a secret-mounted file or base64 PEM. Keep the key out of source control.
BANKING_REDIRECT_URI=
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_FILE=
ENABLE_BANKING_PRIVATE_KEY_B64=
BANKING_ENCRYPTION_KEY_B64=
# Immutable Spendime user UUID in this database. Missing or invalid denies all banking access.
BANKING_OWNER_USER_ID=
# Defaults off. In NODE_ENV=production, banking routes and worker stay disabled until explicitly set to 1.
BANKING_PRODUCTION_ENABLED=0
# Separate PRODUCTION application. Leave blank and disabled until you manually
# activate Restricted Mode for your own linked accounts in Enable Banking.
# Production must use HTTPS and its own encryption key and database.
ENABLE_BANKING_PRODUCTION_APP_ID=
ENABLE_BANKING_PRODUCTION_PRIVATE_KEY_FILE=
ENABLE_BANKING_PRODUCTION_PRIVATE_KEY_B64=
BANKING_PRODUCTION_ENCRYPTION_KEY_B64=
BANKING_PRODUCTION_REDIRECT_URI=
# Independent opt-in for the scheduled worker. Keep 0 during first review.
BANKING_PRODUCTION_WORKER_ENABLED=0
# Optional local Mock ASPSP polling interval, 5-360 minutes. Default: 360.
# Ignored in production and for all other institutions.
BANKING_SANDBOX_SYNC_INTERVAL_MINUTES=360

# External AI stays off for real financial data until paid billing and privacy review.
GEMINI_ENABLED=0
GEMINI_PAID_PROJECT=0
GEMINI_PRIVACY_APPROVED=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
