# Copy outside Git as .env.staging.local and replace every placeholder.
# This stack uses its own database volume and network. Do not copy production secrets or data.
NODE_ENV=production
POSTGRES_DB=spendime_staging
POSTGRES_USER=staging_admin
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD
APP_DB_USER=staging_app
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_PASSWORD
DATABASE_URL=postgresql://staging_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@postgres:5432/spendime_staging
POSTGRES_VOLUME_NAME=spendime_staging_postgres_data
SPENDIME_NETWORK_NAME=spendime_staging_internal
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=55440
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001
APP_ORIGIN=https://staging.example.invalid
COOKIE_SECURE=always
TRUST_PROXY=1
BANKING_OWNER_USER_ID=
BANKING_PRODUCTION_ENABLED=0
BANKING_REDIRECT_URI=
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_FILE=
ENABLE_BANKING_PRIVATE_KEY_B64=
BANKING_ENCRYPTION_KEY_B64=REPLACE_WITH_UNIQUE_32_BYTE_BASE64_KEY
GEMINI_ENABLED=0
