# Copy to an untracked local environment file. Never put these values in VITE_*.
NODE_ENV=development
HOSTNAME=localhost
PORT=3000
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=never
TRUST_PROXY=0
DATABASE_URL=postgresql://spendime_app:REPLACE_ME@localhost:5432/spendime_sandbox
# Use the authenticated test user's UUID from your sandbox database.
BANKING_OWNER_USER_ID=
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_FILE=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Preserve this key across restarts; it encrypts stored provider sessions.
BANKING_ENCRYPTION_KEY_B64=
# Register this exact URL with the sandbox provider. Localhost ports may differ.
BANKING_REDIRECT_URI=http://localhost:3000/api/banking/callback
BANKING_SANDBOX_SYNC_INTERVAL_MINUTES=360
BANKING_PRODUCTION_ENABLED=0
BANKING_PRODUCTION_WORKER_ENABLED=0
GEMINI_ENABLED=0
