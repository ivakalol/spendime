{
  "name": "spendime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted personal finance PWA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "dev": "vite",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:client": "vitest run tests/client",
    "test:auth": "vitest run tests/auth.integration.test.ts",
    "test:finance": "vitest run tests/finance.integration.test.ts"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.47.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
